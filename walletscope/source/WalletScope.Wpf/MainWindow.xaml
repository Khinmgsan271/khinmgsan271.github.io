<Window x:Class="WalletScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WalletScope — Local PC Wallet Software Inventory"
        Height="750" Width="1200" MinHeight="600" MinWidth="830"
        Background="#101720" Foreground="#EFF2F2"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EFF2F2"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#182631"/>
      <Setter Property="Background" Value="#DFB69C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,19">
      <TextBlock Text="WALLETSCOPE / LOCAL INVENTORY" Foreground="#9ADFBE"
                 FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Wallet software inventory" FontSize="30"
                 FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="Windows desktop project · .NET 8 WPF · user-initiated local scan"
                 Foreground="#A6B6C1" Margin="0,8,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#19342F" BorderBrush="#426D64"
            BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#C2DBD1"
                 Text="PRIVACY: The app starts with fictional sample records. A scan runs only after you click 'Scan this PC'. It checks allowlisted extension directory existence and installed-app registry names, never wallet contents. It makes no network requests, stores no scan results, and never touches keys, phrases, addresses or balances."/>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
      <Button x:Name="ScanButton" Content="Scan this PC (local only)" Click="OnScanClicked"/>
      <Button Content="Use fictional demo" Click="OnDemoClicked"/>
      <TextBlock x:Name="ModeLabel" Text="MODE: FICTIONAL DEMO"
                 Foreground="#9ADFBE" VerticalAlignment="Center" Margin="14,0,0,0"
                 FontSize="12" FontWeight="SemiBold"/>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0"
               TextChanged="OnSearchChanged" VerticalContentAlignment="Center"
               Height="40" Margin="0,0,12,0" Padding="10" FontSize="13"
               ToolTip="Search displayed inventory names and labels"/>
      <ComboBox x:Name="StatusPicker" Grid.Column="1"
                Height="40" Margin="0,0,12,0" SelectionChanged="OnStatusChanged"
                SelectedIndex="0" FontSize="12">
        <ComboBoxItem Content="All statuses"/>
        <ComboBoxItem Content="Installed"/>
        <ComboBoxItem Content="Not installed"/>
      </ComboBox>
      <Button Grid.Column="2" Content="Export displayed CSV" Click="OnExportClicked"/>
    </Grid>
    <DataGrid Grid.Row="4" x:Name="InventoryGrid" ItemsSource="{Binding VisibleRows}"
              Background="#192634" Foreground="#EAF0F1" BorderBrush="#405564"
              BorderThickness="1" HeadersVisibility="Column"
              CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" AutoGenerateColumns="False"
              RowBackground="#192634" AlternatingRowBackground="#233441"
              AlternationCount="2" ColumnHeaderHeight="38" RowHeight="43"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#385060"
              FontSize="12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Wallet software" Binding="{Binding WalletName}" Width="1.3*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding AppType}" Width="1.2*"/>
        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="*"/>
        <DataGridTextColumn Header="Browser profile label" Binding="{Binding BrowserProfile}" Width="1.4*"/>
        <DataGridTextColumn Header="Approx. install metadata" Binding="{Binding SampleDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=Unknown}" Width="1.4*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="5" Margin="0,16,0,0">
      <TextBlock x:Name="CountLabel" DockPanel.Dock="Left"
                 Foreground="#A6B6C1" FontSize="12" Text="Fictional records"/>
      <TextBlock Text="Never run against a PC you do not own or administer."
                 Foreground="#849BA6" FontSize="11" HorizontalAlignment="Right"/>
    </DockPanel>
  </Grid>
</Window>