<Window x:Class="WalletScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WalletScope — Synthetic Inventory Demo"
        Height="700" Width="1120" MinHeight="540" MinWidth="780"
        Background="#101720" Foreground="#EFF2F2"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EFF2F2"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#182631"/>
      <Setter Property="Background" Value="#DFB69C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="WALLETSCOPE / UI LAB" Foreground="#9ADFBE" FontSize="12" FontWeight="Bold"/>
        <TextBlock Text="Software inventory — demo" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Text="Original portfolio prototype; 100% fictional records" Foreground="#A6B6C1" Margin="0,8,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#19342F" BorderBrush="#426D64" BorderThickness="1"
            CornerRadius="6" Padding="17" Margin="0,0,0,22">
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#C2DBD1"
                 Text="Privacy: This demo does not inspect devices, wallet installations, browser extensions, keys, seed phrases, addresses, or balances. All records are hardcoded fictional examples."/>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnSearchChanged"
               VerticalContentAlignment="Center" Height="40" Margin="0,0,12,0"
               Padding="10" FontSize="13" ToolTip="Search fictional records"/>
      <ComboBox x:Name="StatusPicker" Grid.Column="1" Height="40" Margin="0,0,12,0"
                SelectionChanged="OnStatusChanged" SelectedIndex="0" FontSize="12">
        <ComboBoxItem Content="All statuses"/>
        <ComboBoxItem Content="Installed"/>
        <ComboBoxItem Content="Not installed"/>
      </ComboBox>
      <Button Grid.Column="2" Content="Export sample CSV" Click="OnExportClicked"/>
    </Grid>
    <DataGrid Grid.Row="3" x:Name="InventoryGrid" ItemsSource="{Binding VisibleRows}"
              Background="#192634" Foreground="#EAF0F1" BorderBrush="#405564"
              BorderThickness="1" HeadersVisibility="Column"
              CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" AutoGenerateColumns="False"
              RowBackground="#192634" AlternatingRowBackground="#233441" AlternationCount="2"
              ColumnHeaderHeight="38" RowHeight="43" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#385060" FontSize="12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Application" Binding="{Binding WalletName}" Width="1.3*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding AppType}" Width="1.2*"/>
        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="*"/>
        <DataGridTextColumn Header="Example profile" Binding="{Binding BrowserProfile}" Width="1.4*"/>
        <DataGridTextColumn Header="Sample date" Binding="{Binding SampleDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
        <DataGridTextColumn Header="Fictional status" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" x:Name="CountLabel" Foreground="#A6B6C1"
               Margin="0,16,0,0" FontSize="12" Text="Sample inventory only"/>
  </Grid>
</Window>